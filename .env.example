# Env dev ở máy: copy thành `.env.local` (bị gitignore) — backend nạp .env.local, rồi .env làm fallback.
# Production KHÔNG dùng file này: xem .env.production ở thư mục gốc repo (./deploy.sh env).

# MongoDB Connection String
MONGO_URI=mongodb://admin:secret@localhost:27017/studio_db?authSource=admin

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5001
NODE_ENV=development

# CORS (production only, comma-separated for multiple origins)
# CORS_ORIGIN=https://your-frontend-domain.com

# Seed
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=Admin@1234

# Seed admin credentials
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=Admin@1234

# Telegram bot (thông báo lịch chụp)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Chuỗi bí mật kiểm tra header X-Telegram-Bot-Api-Secret-Token của webhook
TELEGRAM_WEBHOOK_SECRET=

# Google Apps Script Web App — tạo folder Drive & ghi Sheet khi tạo lịch
# URL lấy sau khi Deploy Apps Script dạng Web app (Execute as me, Access: Anyone)
GAS_WEBHOOK_URL=
# Chuỗi bí mật dùng chung, phải trùng Script Property "SECRET" bên Apps Script
GAS_WEBHOOK_SECRET=

# Apps Script hợp đồng (google-apps-script/Code_create_HD.gs) — cập nhật ô Tiền cọc / Đợt 2
# trên hợp đồng đã tạo khi lớp ghi nhận cọc. Cùng URL web app mà frontend dùng để tạo hợp đồng
# (CONTRACT_SCRIPT_URL trong frontend/src/components/organisms/ContractDialog.tsx).
# Thiếu URL hoặc SECRET → bỏ qua đồng bộ (log cảnh báo).
CONTRACT_SCRIPT_URL=https://script.google.com/macros/s/<deployment-id>/exec
# Bắt buộc: phải trùng Script Property "SECRET" của project Apps Script hợp đồng
CONTRACT_SCRIPT_SECRET=
